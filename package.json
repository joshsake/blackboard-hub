{
  "name": "blackboard-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Blackboard coordination hub and the test framework its layers drive.",
  "scripts": {
    "board": "node bin/board.mjs",
    "test:board": "bash test/smoke.sh && bash test/queue.sh",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=ui",
    "test:load": "k6 run tests/load/baseline.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0"
  }
}
